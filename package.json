{
  "name": "pixel-portfolio",
  "version": "0.1.0",
  "private": true,
  "description": "Personal portfolio with an explorable 3D campus and a spotlight one-page interface",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "validate:content": "tsx scripts/validate-content.ts",
    "validate:assets": "tsx scripts/validate-game-assets.ts",
    "assets:build": "node scripts/build-game-assets.mjs",
    "assets:compress": "node scripts/compress-game-assets.mjs",
    "test:world": "tsx scripts/verify-world.ts",
    "test:physics": "node --import tsx scripts/verify-physics.ts",
    "test:frame-cpu": "node --import tsx scripts/verify-frame-cpu.ts && node --import tsx scripts/verify-travel-hotpath.ts && node scripts/verify-route-idle.mjs",
    "test:startup": "node --import tsx scripts/verify-world-lifecycle.ts && node scripts/verify-audio-startup.mjs",
    "test:travel-presentation": "node scripts/verify-travel-presentation.mjs",
    "test:scooter-render": "node scripts/verify-scooter-render.mjs",
    "test:drift": "node --import tsx scripts/verify-drift.ts && node --import tsx scripts/verify-skid-trails.ts && node --import tsx scripts/verify-skid-uploads.mjs",
    "test:buildings": "node --import tsx scripts/verify-building-collision.ts",
    "test:shore": "node --import tsx scripts/verify-shore-rails.ts && node --import tsx scripts/verify-shore-collision.ts",
    "test:camera-follow": "tsx scripts/verify-camera-follow.ts",
    "test:contact": "node --import tsx scripts/verify-contact-route.ts",
    "test:http": "node scripts/verify-http.mjs",
    "test:gltf": "node --import tsx scripts/verify-gzip-assets.ts && node --import tsx scripts/verify-gzip-gltf.ts",
    "build:cf": "node scripts/build-cloudflare.mjs",
    "preview:cf": "npm run build:cf && opennextjs-cloudflare preview",
    "deploy:cf": "npm run build:cf && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/rapier": "^2.2.0",
    "gray-matter": "^4.0.3",
    "mitt": "^3.0.1",
    "motion": "^12.0.0",
    "next": "^16.3.8",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rehype-pretty-code": "^0.14.5",
    "shiki": "^3.0.0",
    "three": "^0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.8",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.0.0",
    "wrangler": "^4.145.0"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.10"
    }
  }
}
