# Copy to .env.local for local development. NEVER commit real values.
# See docs/DEPLOYMENT.md for how to set these on Vercel and Cloudflare.

# --- Contact form (server-side only, never exposed to the browser) ---
# https://resend.com: API key for sending contact form emails
RESEND_API_KEY=
# Email address that receives contact form submissions
CONTACT_TO_EMAIL=you@example.com
# Cloudflare Turnstile secret key (https://dash.cloudflare.com -> Turnstile)
# Dev test secret (always passes): 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Public (safe to expose, compiled into the client bundle) ---
# Turnstile site key. Dev test site key (always passes): 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Cloudflare Web Analytics beacon token (optional, analytics disabled if empty)
NEXT_PUBLIC_CF_BEACON_TOKEN=
# Canonical site URL (used for SEO metadata, sitemap, RSS)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
